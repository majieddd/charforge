+class MultiViewConditioning:
+    """Stochastic multi-view conditioning for the flow samplers.
+
+    TRELLIS is trained with a single conditioning image, so its cross-attention expects one
+    view's worth of context tokens. The obvious way to pass several views - concatenating their
+    DINOv3 features along the token axis - triples the context length and gives every view equal
+    weight, and measurably wrecks the result: on the CharForge test character it tore the surface
+    (open edges 2.30% -> 10.58%) and destroyed the face, because the front reference that carried
+    the facial detail was diluted to a third of the context.
+
+    The scheme TRELLIS actually uses varies *which* view conditions each denoising step. Every
+    individual forward pass then sees exactly the token layout the model was trained on, while
+    the trajectory as a whole is pulled toward agreeing with all the views. That is what this
+    implements.
+
+    modes:
+      cycle     round-robin over the views. Deterministic and reproducible.
+      weighted  sample a view per step from `weights`. Use this to keep the reference image
+                dominant - it is the only view with a real face - while still letting the side
+                and back views steer the geometry they alone can see.
+
+    The sampler reads whichever instance is assigned to ACTIVE_MULTIVIEW, rather than taking it
+    as an argument, because the scheme has to apply identically across all four sampling stages
+    (sparse structure, low- and high-res shape, texture) and threading it through each call site
+    would be more surface area for the two of them to drift apart.
+    """
+
+    def __init__(self, views, mode="cycle", weights=None, seed=0):
+        if not views:
+            raise ValueError("MultiViewConditioning needs at least one view")
+        shapes = {tuple(v.shape) for v in views}
+        if len(shapes) != 1:
+            raise ValueError(f"all conditioning views must share a shape, got {shapes}")
+        self.views = list(views)
+        self.mode = mode
+        self.weights = weights
+        self.seed = seed
+
+    def schedule(self, steps):
+        n = len(self.views)
+        if n == 1:
+            return [0] * steps
+        if self.mode == "cycle":
+            return [i % n for i in range(steps)]
+        if self.mode == "weighted":
+            w = np.asarray(self.weights if self.weights else [1.0] * n, dtype=np.float64)
+            if len(w) != n:
+                raise ValueError(f"got {len(w)} weights for {n} views")
+            w = w / w.sum()
+            rng = np.random.default_rng(self.seed)
+            # force the first step onto view 0: the earliest steps fix global layout, and view 0
+            # is the reference image
+            plan = [0] + [int(i) for i in rng.choice(n, size=max(steps - 1, 0), p=w)]
+            return plan[:steps]
+        raise ValueError(f"unknown multi-view mode {self.mode!r}")
+
+
+# Set by generate.py when several conditioning images are supplied; None means single-view.
+ACTIVE_MULTIVIEW = None
+
+
