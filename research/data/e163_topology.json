{
 "_about": "E163 (lane topology): measurements behind the quad-join experiment. Each figure is read from the JSON named under 'sources' by the commands under 'reproduce'. Baseline = the default 60k-triangle cage (solid_decimate); quads = the same cage with triangle pairs joined (retopo.py --quads --quad-face-angle 60 --quad-shape-angle 60). Topology and shape are measured on the polygon .obj that retopo.py writes beside each retopo.glb, so both sides keep their quads.",
 "sources": {
  "topology": "work/_audit/topo_<char>_{base,quads}_obj.json (blender/quad_audit.py)",
  "shape_E132": "work/_audit/mq_<char>_{base_obj,quads}.json (blender/model_quality.py, then tools/model_quality.py)",
  "texture_E132": "work/_audit/mqt_<char>_{base,quads}.json (tools/model_quality.py --work)",
  "stress_battery": "work/_audit/deform_{base,quads}/<char>[_quads]_stress.json (tools/deform_suite.py)",
  "clip_audit": "work/_audit/aberr/<char>_{base,quads}.json (blender/aberration_audit.py --step 2 --bvh-step 6 --skin dqs)",
  "join_sweep": "work/_audit/sweep/f<face>_s<shape>.json (pip; retopo at bake 512)",
  "quadriflow_probe": "work/_audit/quad_probe_pip.log (blender/quad_probe.py)"
 },
 "reproduce": [
  "cp -c -R work/<c> work/<c>_quads   # copy-on-write clone (and work/<c>_base for the default build)",
  "python pipeline/despeck_source.py --mesh work/<c>_quads/mesh.glb --out work/<c>_quads/source_albedo.png",
  "blender -b -noaudio --python blender/retopo.py -- --source-albedo work/<c>_quads/source_albedo.png --mesh work/<c>_quads/mesh.glb --cage work/<c>_quads/solid_hands.glb --out work/<c>_quads/retopo.glb --bake-res 4096 --cage-extrusion 0.006 --ray-distance 0.014 --joints work/<c>_quads/joints_refined.json --head-share 0.28 --quads --tris 60000 --quad-face-angle 60 --quad-shape-angle 60",
  "python tools/hands_check.py <c>_quads --strict",
  "python charforge.py make --name <c>_quads --from labels --until animate",
  "blender -b -noaudio --python blender/quad_audit.py -- --mesh work/<c>_quads/retopo_polys.obj --out work/_audit/topo_<c>_quads_obj.json",
  "python tools/deform_suite.py --name <c>_quads --out work/_audit/deform_quads --force",
  "blender -b -noaudio --python blender/aberration_audit.py -- --blend work/<c>_quads/final.blend --out work/_audit/aberr/<c>_quads.json --step 2 --bvh-step 6 --skin dqs --force",
  "blender -b -noaudio --python blender/quad_probe.py -- --mesh work/pip/solid_hands.glb --sizes 0.012,0.01,0.008,0.006,0.005,0.004,0.003"
 ],
